# Noted — local environment
#
# Copy this file to `.env.local` and fill in your own values:
#
#   cp .env.example .env.local
#
# Every service below has a free tier. Create your OWN project on each one —
# do not paste keys from a walkthrough, a screenshot, or a teammate. The values
# marked SECRET are server-side credentials: anything holding one can act as
# your application, so they belong in `.env.local` (gitignored) and nowhere else.
#
# `.env.local` is gitignored. Keep it that way.

# ── Convex (database + backend) ──────────────────────────────────────────────
# `npx convex dev` creates a dev deployment and writes both of these for you the
# first time you run it. You do not have to fill them in by hand.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ── Clerk (authentication) ───────────────────────────────────────────────────
# dashboard.clerk.com → Create application → API keys.
# The publishable key is safe in the browser; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me            # SECRET

# The Clerk domain your Convex deployment trusts for JWT verification. Set it on
# the Convex deployment too: `npx convex env set CLERK_DOMAIN https://...`
CLERK_DOMAIN=https://your-subdomain.clerk.accounts.dev

# ── EdgeStore (file uploads) ─────────────────────────────────────────────────
# edgestore.dev → new project → API keys. Both are server-side.
EDGE_STORE_ACCESS_KEY=replace_me               # SECRET
EDGE_STORE_SECRET_KEY=replace_me               # SECRET

# ── Encryption (BYOK provider keys at rest) ──────────────────────────────────
# AES-256-GCM key used to encrypt users' own AI provider keys before they are
# stored. Generate a fresh one — never reuse another environment's:
#   openssl rand -base64 32
ENCRYPTION_KEY=replace_me                      # SECRET

# ── Amplitude (analytics + experiments) ──────────────────────────────────────
# amplitude.com → your project → Settings → Projects → API keys.
# Optional: the app runs without these, it just does not report anything.
NEXT_PUBLIC_AMPLITUDE_API_KEY=replace_me
NEXT_PUBLIC_AMPLITUDE_EXPERIMENT_CLIENT_DEPLOYMENT_KEY=client-replace_me
AMPLITUDE_EXPERIMENT_SERVER_DEPLOYMENT_KEY=server-replace_me   # SECRET

# Used only by `npm run seed:amplitude` to send the synthetic cohort.
AMPLITUDE_API_KEY=replace_me                   # SECRET

# ── Feature flags ────────────────────────────────────────────────────────────
# Local fallback for the hiring page flag when Amplitude Experiment is not set up.
HIRING_VIBE_PMS_PAGE_DEFAULT=false
